# Clé API Resend (https://resend.com) pour recevoir les demandes d'estimation par e-mail
RESEND_API_KEY=
# Adresse d'expédition vérifiée chez Resend (domaine topsail-grasse.fr à vérifier dans Resend)
ESTIMATION_FROM="Topsail <estimation@topsail-grasse.fr>"
# Adresse qui reçoit les demandes
ESTIMATION_TO=contact@topsail-grasse.fr

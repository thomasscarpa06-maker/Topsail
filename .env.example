# Clé API Resend (https://resend.com) pour recevoir les demandes d'audit par e-mail
RESEND_API_KEY=
# Adresse d'expédition vérifiée chez Resend (domaine topsail-grasse.fr à vérifier dans Resend)
CONTACT_FROM="Topsail <contact@topsail-grasse.fr>"
# Adresse qui reçoit les demandes d'audit
CONTACT_TO=contact@topsail-grasse.fr
